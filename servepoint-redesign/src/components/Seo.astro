---
/**
 * Head tags for every page (docs/08 section 2): title, description, canonical on the production origin with a trailing
 * slash, robots, Open Graph and Twitter card. Titles and descriptions come from the templates in docs/08 section 1.
 */
import { site, absoluteUrl } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path of the page, for example "/pricing/". Used for the canonical and og:url. */
  path: string;
  noindex?: boolean;
  ogImage?: string;
  type?: "website" | "article";
}
const { title, description, path, noindex = false, ogImage = "/og-default.png", type = "website" } = Astro.props;
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
<meta name="theme-color" content="#0A1E45" />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_CA" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
