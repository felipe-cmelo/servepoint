---
/** Visible breadcrumb (docs/04 section 5). The matching BreadcrumbList is built from the same items. */
interface Props {
  items: { name: string; path?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((it, i) =>
      i === items.length - 1 || !it.path
        ? <li><span aria-current="page">{it.name}</span></li>
        : <li><a href={it.path}>{it.name}</a></li>
    )}
  </ol>
</nav>
