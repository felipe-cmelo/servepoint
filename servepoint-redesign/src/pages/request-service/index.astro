---
/** Request service (docs/pages/about-request-service-legal.md, docs/05 section 4). Copy: content/request-service.md. Layout: docs/15. */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import RequestForm from "../../components/RequestForm.astro";
import { site } from "../../data/site";
import { breadcrumbs } from "../../data/schema";
---

<Base
  title="Request service in Vancouver, BC | ServePoint Canada"
  description="Send a process serving, court filing or corporate search instruction. We confirm availability and next steps the same business day."
  path="/request-service/"
  schema={[breadcrumbs([{ name: "Home", path: "/" }, { name: "Request service", path: "/request-service/" }])]}
  noMobileBar
>
  <PageHero
    h1="Request service"
    lead="Tell us what to serve, file or search. We confirm availability and next steps the same business day."
    crumbs={[{ name: "Request service" }]}
    actions={false}
  />

  <section class="section theme-light" id="request" aria-label="Request form" style="padding-top:clamp(2rem,1.5rem + 2vw,3.5rem)">
    <div class="wrap-wide req-grid">
      <RequestForm idPrefix="rf" />

      <aside class="req-aside" aria-label="About your request">
        <div class="card live-sum" data-live-sum>
          <h2 style="font-size:var(--fs-h3);margin-bottom:var(--s-3)">Your instruction</h2>
          <dl>
            <div><dt>Service</dt><dd data-sum="service">Process serving</dd></div>
            <div><dt>Urgency</dt><dd data-sum="urgency">Standard</dd></div>
            <div><dt>Firm</dt><dd data-sum="firm" class="empty">Not given</dd></div>
            <div><dt>Court file number</dt><dd data-sum="court" class="empty">Not given</dd></div>
            <div><dt>Matter reference</dt><dd data-sum="matter" class="empty">Not given</dd></div>
            <div><dt>Deadline</dt><dd data-sum="deadline" class="empty">Not given</dd></div>
          </dl>
          <p data-sum-timing style="margin-top:var(--s-3);font-size:var(--fs-sm)">First attempt typically within 24 hours of receiving your documents and instructions.</p>
        </div>

        <div class="card stack">
          <h2 style="font-size:var(--fs-h3)">What to send</h2>
          <p>The documents, the service address, the deadline and the court file number, if any.</p>
          <h2 style="font-size:var(--fs-h3);margin-top:var(--s-4)">After you submit</h2>
          <ol class="seq">
            <li>We confirm availability and next steps the same business day.</li>
            <li>You email the documents to <a href={site.emailHref}>{site.email}</a> with your reference.</li>
            <li>Service begins, with updates on each attempt.</li>
            <li>You receive a sworn affidavit of service.</li>
          </ol>
        </div>

        <div class="card stack">
          <h2 style="font-size:var(--fs-h3)">Prefer to call or email</h2>
          <p><a class="go" href={`tel:${site.phone.tel}`}><Icon name="phone" /> {site.phone.display}</a></p>
          <p><a class="go" href={site.emailHref}><Icon name="mail" /> {site.email}</a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>
