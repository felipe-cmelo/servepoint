{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/services/", "destination": "/process-serving/", "statusCode": 301 },
    { "source": "/services/process-serving/", "destination": "/process-serving/", "statusCode": 301 },
    { "source": "/services/court-services/", "destination": "/court-filing/", "statusCode": 301 },
    { "source": "/services/corporate-search/", "destination": "/corporate-search/", "statusCode": 301 },
    { "source": "/areas/", "destination": "/coverage/", "statusCode": 301 },
    { "source": "/for-us-law-firms/", "destination": "/out-of-province-and-us/", "statusCode": 301 },
    { "source": "/contact/", "destination": "/request-service/", "statusCode": 301 },
    { "source": "/thank-you/", "destination": "/request-service/received/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
